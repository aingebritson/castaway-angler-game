    "fillsCells": [],
    "source": "The castaway's journal"
  },
  {
    "id": "temensis-low",
    "speciesId": "cichla-temensis",
    "dimension": "when",
    "text": "When the water drops, from September to the year’s end, the big tucunaré crowd into the lagoons with nowhere else to go.",
