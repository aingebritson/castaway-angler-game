[
  {
    "id": "squirrelfish-night",
    "speciesId": "holocentrus-adscensionis",
    "dimension": "when",
    "text": "Red fish with great dark eyes come out of the rock only after dark.",
    "fillsCells": [
      "phase:night",
      "zone:rocky-point/shallows"
    ],
    "source": "The castaway's journal"
  },
  {
    "id": "bonefish-flats",
    "speciesId": "albula-vulpes",
    "dimension": "where",
    "text": "Grey ghosts root across the lagoon flats with their tails in the air.",
    "fillsCells": [
      "zone:lagoon/flats"
    ],
    "source": "The castaway's journal"
  },
  {
    "id": "bonefish-bait",
    "speciesId": "albula-vulpes",
