      "phase:night",
      "zone:mariua-waterfront/river-edge"
    ],
    "source": "Seu Raimundo"
  },
  {
    "id": "caparari-live",
    "speciesId": "pseudoplatystoma-punctifer",
    "dimension": "bait",
    "text": "A caparari wants a live sardinha after dark. It ambushes them where the sand drops off.",
    "fillsCells": [
      "bait:livefish",
      "zone:rio-channel/channel-edge"
    ],
    "source": "Seu Bené"
  },
  {
    "id": "arapaima-air",
    "speciesId": "arapaima-gigas",
    "dimension": "method",
    "text": "There is a fish in the Amazon lakes so big it has to come up for air every quarter of an hour. Watch for the swirl, and cast to it.",
    "fillsCells": [
      "zone:rio-lagoon/open-lagoon"
    ],
    "source": "Mr Alvarez"
  },
  {
    "id": "arapaima-low",
    "speciesId": "arapaima-gigas",
    "dimension": "when",
    "text": "The pirarucu are easiest to find as the water drops and the lagoon shrinks, September to December. They must be let go: they are counted, every one.",
    "fillsCells": [
      "month:8",
      "month:9",
      "month:10",
      "month:11"
    ],
    "source": "Seu Raimundo"
  },
  {
    "id": "prawn-matapi",
    "speciesId": "macrobrachium-brasiliense",
    "dimension": "method",
    "text": "Sink a matapi by the floating houses with a scrap of fish in it, leave it overnight, and you will have prawns for the catfish.",
    "fillsCells": [
      "bait:trap",
      "zone:mariua-waterfront/moorings"
    ],
    "source": "Joelma"
  },
  {
    "id": "cardinal-net",
    "speciesId": "paracheirodon-axelrodi",
    "dimension": "method",
    "text": "The piabeiros scoop cardinals from the forest streams with a fine hand net. There is a stream into the island lagoon.",
    "fillsCells": [
      "bait:net",
      "zone:rio-lagoon/igarape"
    ],
    "source": "Dr Prado"
  }
]
