    "fillsCells": [
      "month:5",
      "month:6",
      "month:7"
    ],
    "source": "Seu Bené"
  },
  {
    "id": "eel-night",
    "speciesId": "electrophorus-varii",
    "dimension": "when",
    "text": "The poraquê hunts at night along the lagoon edge. Do not reach into the roots for your line.",
    "fillsCells": [
      "phase:night",
      "zone:rio-lagoon/margin"
    ],
    "source": "Seu Bené"
  },
  {
    "id": "eel-margin",
    "speciesId": "electrophorus-varii",
    "dimension": "method",
    "text": "An electric eel comes up to breathe, like the pirarucu. It will take a worm or a scrap of fish in the shallows after dark.",
    "fillsCells": [
      "bait:worm",
      "bait:cutfish"
    ],
    "source": "Dr Prado"
  },
