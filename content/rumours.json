    "fillsCells": [
      "phase:night",
      "zone:rocky-point/tide-pools"
    ],
    "source": "The castaway's journal"
  },
  {
    "id": "octopus-crab",
    "speciesId": "octopus-briareus",
    "dimension": "bait",
    "text": "It emptied a trap baited with crab and left by the same door.",
    "fillsCells": [
      "bait:trap"
    ],
    "source": "The castaway's journal"
  },
  {
    "id": "permit-crab",
    "speciesId": "trachinotus-falcatus",
    "dimension": "bait",
    "text": "The round silver fish with sickle fins wants a crab above anything else.",
    "fillsCells": [
      "bait:crab"
    ],
    "source": "The castaway's journal"
  },
  {
    "id": "permit-flats",
    "speciesId": "trachinotus-falcatus",
    "dimension": "where",
    "text": "They tip down on the lagoon flats and show black fin-tips above the water.",
    "fillsCells": [
      "zone:lagoon/flats"
    ],
    "source": "The castaway's journal"
  },
  {
    "id": "mutton-dusk",
    "speciesId": "lutjanus-analis",
    "dimension": "when",
    "text": "Something red and heavy feeds at the reef edge as the light goes.",
    "fillsCells": [
      "phase:dusk",
      "zone:rocky-point/reef-edge"
    ],
    "source": "The castaway's journal"
  },
  {
    "id": "mutton-bait",
    "speciesId": "lutjanus-analis",
    "dimension": "bait",
    "text": "It took a strip of cut fish and went straight down.",
    "fillsCells": [
      "bait:cutfish"
    ],
    "source": "The castaway's journal"
  },
  {
    "id": "tarpon-dawn",
    "speciesId": "megalops-atlanticus",
    "dimension": "when",
    "text": "At first light great silver fish roll in the lagoon channel, gulping air.",
    "fillsCells": [
      "phase:dawn",
      "zone:lagoon/channel"
    ],
    "source": "The castaway's journal"
  },
  {
    "id": "tarpon-feather",
    "speciesId": "megalops-atlanticus",
    "dimension": "bait",
    "text": "One took a feather lure and could not be turned. Not with island gear.",
    "fillsCells": [
      "bait:feather"
    ],
    "source": "The castaway's journal"
  },
  {
    "id": "snook-lights",
    "speciesId": "centropomus-undecimalis",
    "dimension": "when",
