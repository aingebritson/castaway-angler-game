    "fillsCells": [
      "phase:dawn",
      "bait:spoon",
      "zone:town-pier/harbour"
    ],
    "source": "Mr Alvarez, harbourmaster"
  },
  {
    "id": "hogfish-crab",
    "speciesId": "lachnolaimus-maximus",
    "dimension": "bait",
