    "fillsCells": [
      "bait:livefish"
    ],
    "source": "Old Tobias"
  },
  {
    "id": "nassau-winter",
    "speciesId": "epinephelus-striatus",
    "dimension": "when",
    "text": "The Nassau gather to spawn on the winter moons, at a few points out on the reef. My father filled boats with them. Do not be my father.",
    "fillsCells": [],
    "source": "Old Tobias"
  },
  {
    "id": "nassau-edge",
    "speciesId": "epinephelus-striatus",
    "dimension": "where",
