    "fillsCells": [
      "phase:night",
      "zone:town-pier/pilings"
    ],
    "source": "Mr Alvarez, harbourmaster"
  },
  {
    "id": "snook-live",
    "speciesId": "centropomus-undecimalis",
    "dimension": "bait",
