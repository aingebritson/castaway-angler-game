    "speciesId": "mycteroperca-bonaci",
    "dimension": "where",
    "text": "The black ones live under the ledge at the reef edge and deeper. You will not see them. They see you.",
    "fillsCells": [
      "zone:patch-reef/reef-edge",
      "zone:patch-reef/deep"
    ],
    "source": "Old Tobias"
  },
  {
    "id": "blackgrouper-dusk",
    "speciesId": "mycteroperca-bonaci",
    "dimension": "when",
